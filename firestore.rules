rules_version = '2';

// Phân quyền thật sự cho dữ liệu. Kiểm tra trong React chỉ ẩn nút bấm —
// ai cũng có thể gọi thẳng Firebase SDK từ trình duyệt, nên quyền phải
// được chặn ở đây thì mới có hiệu lực.
//
// Thêm admin: Firestore Database > collection 'admins' > tạo document
//   Document ID : email viết thường, ví dụ phamhoangson162@gmail.com
//   Field       : role = "viewer" (chỉ xem) hoặc "owner" (xem + xoá)
// Không cần sửa biến env, không cần build hay deploy lại.
//
// Triển khai file này: Firebase Console > Firestore Database > Rules > Publish
// Hoặc: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Email đã đăng nhập, viết thường. Trả '' nếu chưa đăng nhập hoặc email
    // chưa xác minh -> mọi so sánh bên dưới đều trượt (fail closed).
    function email() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    // Chủ sở hữu cố định. Giữ ở đây để không bao giờ tự khoá mình ra ngoài,
    // kể cả khi collection 'admins' rỗng hoặc bị xoá nhầm.
    function isBootstrapOwner() {
      return email() == 'luonghaianh1208@gmail.com';
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(email());
    }

    // && dừng sớm nên khi chưa đăng nhập sẽ không dựng path rỗng
    function isListedAdmin() {
      return email() != '' && exists(adminPath());
    }

    function isAdmin() {
      return isBootstrapOwner() || isListedAdmin();
    }

    function isOwner() {
      return isBootstrapOwner() || (isListedAdmin() && get(adminPath()).data.role == 'owner');
    }

    // Admin thường chỉ đọc được đúng document của mình nên không lấy được
    // danh sách. Owner đọc cả danh sách để hiện trong tab Phân quyền.
    match /admins/{adminEmail} {
      allow get:  if email() != '' && (adminEmail == email() || isOwner());
      allow list: if isOwner();

      // Chỉ owner cấp quyền được, và chỉ với vai trò hợp lệ. Ràng buộc id là
      // email viết thường để không tạo được hai bản ghi cho cùng một người.
      allow create, update: if isOwner()
                            && adminEmail == adminEmail.lower()
                            && adminEmail.matches('^[^@]+@[^@]+[.][^@]+$')
                            && request.resource.data.role in ['owner', 'viewer'];

      // Chủ sở hữu cố định không nằm trong collection này, chặn thêm cho chắc
      allow delete: if isOwner() && adminEmail != 'luonghaianh1208@gmail.com';
    }

    // Học sinh chưa đăng nhập vẫn phải gửi được bài làm, nên create mở.
    // Nhưng đọc lại toàn bộ dữ liệu thì chỉ admin, và xoá thì chỉ owner.
    match /users/{docId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow delete: if isOwner();
      allow update: if false;
    }

    match /test_results/{docId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow delete: if isOwner();
      allow update: if false;
    }

    // Mọi collection khác: cấm hoàn toàn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
